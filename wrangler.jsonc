{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy-my",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "95785505-4adb-4474-a96e-412145542614","database_name": "web-app1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4cac3213d5a04eabbaca87628098b917" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
